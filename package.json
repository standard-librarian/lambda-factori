{
  "name": "lambda-factori",
  "private": true,
  "version": "0.1.0",
  "description": "A framework for explaining ideas with moving parts: slide decks, games and study notes as playable, shareable factories.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/standard-librarian/lambda-factori.git"
  },
  "homepage": "https://standard-librarian.github.io/lambda-factori/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "search": "node scripts/search.ts",
    "drive": "node scripts/drive.ts",
    "present": "vite build && vite preview --port 4173 --open \"/#/deck/week1-complexity/1\"",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "effect": "4.0.0-rc.117",
    "pixi.js": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.30.1"
}
