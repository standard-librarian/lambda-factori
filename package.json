{
  "name": "@lambda-factori/monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "A framework for explaining ideas with moving parts: slide decks, games and study notes as playable, shareable factories.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/standard-librarian/lambda-factori.git"
  },
  "homepage": "https://mdht.me/lambda-factori/",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter @lambda-factori/web dev",
    "build": "pnpm --filter './apps/*' build",
    "preview": "pnpm --filter @lambda-factori/web preview",
    "present": "pnpm build && pnpm --filter @lambda-factori/web exec vite preview --port 4173 --open \"/#/deck/week1-complexity/1\"",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p .",
    "test": "vitest run",
    "search": "node scripts/search.ts",
    "drive": "node scripts/drive.ts"
  },
  "dependencies": {
    "@lambda-factori/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
