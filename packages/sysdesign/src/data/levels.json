   "id": "bitly",
   "title": "A URL shortener",
   "difficulty": "easy",
   "practice": {
    "name": "Bitly",
    "url": "https://www.hellointerview.com/learn/system-design/problem-breakdowns/bitly"
   },
   "brief": "People paste long links and get short codes back; far more people follow short codes than create them. A follow must answer fast, and counting clicks must never slow it down. Build it, then 10x the traffic, then lose a server.",
   "estimates": [
    {
     "id": "dau",
     "label": "Daily active users",
     "expr": "100M",
     "value": 100000000,
     "unit": "users"
    },
    {
     "id": "follows",
     "label": "Follows per user per day",
     "expr": "5",
     "value": 5,
     "unit": "per day"
    },
    {
     "id": "avgrps",
     "label": "Average follows per second",
     "expr": "dau * follows / 86400",
     "value": 5787,
     "unit": "rps"
    },
    {
     "id": "peakrps",
     "label": "Peak follows per second (x2)",
     "expr": "avgrps * 2",
     "value": 11574,
     "unit": "rps"
    }
   ],
   "rpsPerToken": 50,
   "seed": 11,
   "datasets": [
    {
     "id": "urls",
     "label": "short code -> long URL",
     "objectKb": 0.5,
     "keys": 100000000,
     "skew": 1.1
    },
    {
     "id": "clicks",
     "label": "click counters",
     "objectKb": 0.1,
     "keys": 100000000,
     "skew": 0
    }
   ],
   "requests": [
    {
     "id": "redirect",
     "label": "GET /:code",
     "color": "#4da3ff",
     "rps": 1000,
     "traffic": {
      "shape": "steady"
     },
     "ops": [
      {
       "do": "compute",
       "ms": 1
      },
      {
       "do": "read",
       "dataset": "urls",
       "consistency": "eventual"
      },
      {
       "do": "enqueue",
       "topic": "clicks"
      },
      {
       "do": "compute",
       "ms": 0,
       "amp": 0.1
      },
      {
       "do": "write",
       "dataset": "clicks",
       "amp": 0.1
      }
     ]
    },
    {
